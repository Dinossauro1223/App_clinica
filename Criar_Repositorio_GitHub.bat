@echo off
setlocal EnableExtensions
chcp 65001 >nul
title Criar repositorio no GitHub

cd /d "%~dp0"

echo ======================================================
echo       CRIAR REPOSITORIO DO PROJETO NO GITHUB
echo ======================================================
echo.
echo Verificando dependencias (Git e GitHub CLI)...
echo Se estiverem ausentes, o script baixara as versoes oficiais.
echo Nao e necessario instalar manualmente nem ter permissao de administrador.
echo.

where powershell.exe >nul 2>&1
if errorlevel 1 goto POWERSHELL_AUSENTE

set "APPCLINICA_B64=%TEMP%\AppClinicaSetup_%RANDOM%.b64"
set "APPCLINICA_PS=%TEMP%\AppClinicaSetup_%RANDOM%.ps1"
> "%APPCLINICA_B64%" echo 
>> "%APPCLINICA_B64%" echo 
>> "%APPCLINICA_B64%" echo 
>> "%APPCLINICA_B64%" echo 
>> "%APPCLINICA_B64%" echo 
>> "%APPCLINICA_B64%" echo 
>> "%APPCLINICA_B64%" echo 
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$b=[IO.File]::ReadAllText($env:APPCLINICA_B64); $s=[Text.Encoding]::Unicode.GetString([Convert]::FromBase64String($b)); [IO.File]::WriteAllText($env:APPCLINICA_PS,$s,[Text.Encoding]::Unicode); & $env:APPCLINICA_PS"
set "PS_RESULT=%ERRORLEVEL%"
del "%APPCLINICA_B64%" >nul 2>&1
del "%APPCLINICA_PS%" >nul 2>&1
if not "%PS_RESULT%"=="0" goto DEPENDENCIAS_ERRO

REM Inclui no PATH as instalacoes portateis e os locais mais comuns de instalacao.
set "PATH=%LOCALAPPDATA%\AppClinicaTools\Git\cmd;%LOCALAPPDATA%\AppClinicaTools\Git\usr\bin;%LOCALAPPDATA%\AppClinicaTools\Git\ucrt64\bin;%LOCALAPPDATA%\AppClinicaTools\Git\mingw64\bin;%LOCALAPPDATA%\AppClinicaTools\GitHubCLI;%ProgramFiles%\Git\cmd;%ProgramFiles%\Git\bin;%ProgramFiles%\GitHub CLI;%ProgramFiles(x86)%\Git\cmd;%LOCALAPPDATA%\Programs\Git\cmd;%LOCALAPPDATA%\Programs\Git\bin;%LOCALAPPDATA%\Programs\GitHub CLI;%PATH%"

where git.exe >nul 2>&1
if errorlevel 1 goto GIT_AUSENTE_APOS_INSTALACAO
where gh.exe >nul 2>&1
if errorlevel 1 goto GH_AUSENTE_APOS_INSTALACAO

echo.
echo Git e GitHub CLI prontos.
echo.

REM Se ja houver um repositorio com remoto origin, nao o sobrescreve.
git rev-parse --is-inside-work-tree >nul 2>&1
if not errorlevel 1 (
    git remote get-url origin >nul 2>&1
    if not errorlevel 1 goto REPO_EXISTENTE
    echo Repositorio Git local ja inicializado sem remoto. Vou reutiliza-lo.
    goto CONTINUAR
)

git init
if errorlevel 1 goto ERRO_GIT

:CONTINUAR
git branch -M main
if errorlevel 1 goto ERRO_GIT

echo.
echo Verificando autenticacao no GitHub...
gh auth status >nul 2>&1
if errorlevel 1 (
    echo.
    echo A autenticacao sera aberta agora. Siga as instrucoes no navegador.
    gh auth login --hostname github.com --git-protocol https --web
    if errorlevel 1 goto GH_NAO_AUTENTICADO
)

gh auth setup-git
if errorlevel 1 goto GH_NAO_AUTENTICADO

echo.
echo Nome do repositorio no GitHub (sem espacos).
set "REPO_NAME=App_clinica"
set /p "REPO_NAME=Nome [App_clinica]: "
if not defined REPO_NAME set "REPO_NAME=App_clinica"

echo.
echo O repositorio sera PRIVADO por padrao.
echo Digite U para publico ou P para privado.
set "VISIBILIDADE=P"
set /p "VISIBILIDADE=Visibilidade [P/U]: "
if /I "%VISIBILIDADE%"=="U" (
    set "FLAG_VISIBILIDADE=--public"
) else if /I "%VISIBILIDADE%"=="P" (
    set "FLAG_VISIBILIDADE=--private"
) else (
    goto VISIBILIDADE_INVALIDA
)

echo.
echo Verificando a identidade do Git...
git config user.name >nul 2>&1
if errorlevel 1 (
    set /p "GIT_NAME=Digite seu nome para os commits: "
    if not defined GIT_NAME goto IDENTIDADE_INVALIDA
    git config user.name "%GIT_NAME%"
    if errorlevel 1 goto ERRO_GIT
)

git config user.email >nul 2>&1
if errorlevel 1 (
    set /p "GIT_EMAIL=Digite seu e-mail do Git: "
    if not defined GIT_EMAIL goto IDENTIDADE_INVALIDA
    git config user.email "%GIT_EMAIL%"
    if errorlevel 1 goto ERRO_GIT
)

echo.
echo Protegendo os dados locais no .gitignore...
findstr /x /c:"# Protecao local AppClinica" ".gitignore" >nul 2>&1
if errorlevel 1 (
    (
        echo.
        echo # Protecao local AppClinica
        echo /arquivos_pacientes/
        echo /clinica.db
        echo /clinica.db.*
        echo /clinica.db-*
        echo *.db
        echo *.sqlite
        echo *.sqlite3
        echo *.pdf
        echo .env
        echo .env.*
        echo !.env.example
        echo .venv/
        echo venv/
        echo __pycache__/
        echo *.pyc
        echo Thumbs.db
    ) >> ".gitignore"
    if errorlevel 1 goto ERRO_GIT
)

REM Remove do indice, sem apagar do computador, arquivos locais sensiveis que
REM possam ter sido adicionados em uma tentativa anterior.
git rm -r --cached --ignore-unmatch -- arquivos_pacientes clinica.db clinica.db.backup_refatoracao clinica.db.backup_reglas >nul 2>&1

echo.
echo Preparando os arquivos para o primeiro commit...
git add -A
if errorlevel 1 goto ERRO_GIT
git status --short

git diff --cached --quiet
if not errorlevel 1 (
    git rev-parse HEAD >nul 2>&1
    if errorlevel 1 goto NENHUM_ARQUIVO
    echo Nao ha alteracoes novas; vou usar o commit local existente.
) else (
    echo.
    echo Criando o primeiro commit...
    git commit -m "Initial commit"
    if errorlevel 1 goto ERRO_GIT
)

echo.
echo Criando o repositorio remoto e enviando os arquivos...
gh repo create "%REPO_NAME%" %FLAG_VISIBILIDADE% --source=. --remote=origin --push
if errorlevel 1 goto ERRO_GITHUB

echo.
echo ======================================================
echo SUCESSO! Repositorio criado e arquivos enviados.
echo ======================================================
echo.
echo Para conferir, execute: gh repo view --web
echo.
pause
exit /b 0

:POWERSHELL_AUSENTE
echo.
echo ERRO: Windows PowerShell nao foi encontrado.
echo Este arquivo usa o PowerShell que acompanha o Windows para instalar as dependencias.
goto FIM_ERRO

:DEPENDENCIAS_ERRO
echo.
echo Nao foi possivel preparar automaticamente Git e/ou GitHub CLI.
echo Verifique sua conexao com a internet e tente novamente.
echo As ferramentas portateis, quando instaladas, ficam em %%LOCALAPPDATA%%\AppClinicaTools.
goto FIM_ERRO

:GIT_AUSENTE_APOS_INSTALACAO
echo.
echo ERRO: Git ainda nao foi localizado depois da instalacao.
goto FIM_ERRO

:GH_AUSENTE_APOS_INSTALACAO
echo.
echo ERRO: GitHub CLI ainda nao foi localizado depois da instalacao.
goto FIM_ERRO

:REPO_EXISTENTE
echo.
echo ERRO: esta pasta ja possui um repositorio Git com remoto origin.
echo Por seguranca, o script nao vai substituir o repositorio remoto existente.
goto FIM_ERRO

:GH_NAO_AUTENTICADO
echo.
echo ERRO: nao foi possivel autenticar no GitHub.
echo Execute gh auth login e tente novamente.
goto FIM_ERRO

:VISIBILIDADE_INVALIDA
echo.
echo Opcao invalida. Execute novamente e escolha P ou U.
goto FIM_ERRO

:IDENTIDADE_INVALIDA
echo.
echo Nome e e-mail sao necessarios para criar o commit.
goto FIM_ERRO

:NENHUM_ARQUIVO
echo.
echo ERRO: nenhum arquivo foi preparado para o commit e nao existe commit local.
goto FIM_ERRO

:ERRO_GIT
echo.
echo ERRO ao executar um comando Git. Leia a mensagem acima.
goto FIM_ERRO

:ERRO_GITHUB
echo.
echo ERRO ao criar/enviar o repositorio pelo GitHub CLI.
echo O commit local foi preservado. Verifique o nome do repositorio e as permissoes.
echo Se o repositorio remoto ja existir, escolha outro nome ou confira: git remote -v
goto FIM_ERRO

:FIM_ERRO
echo.
pause
exit /b 1
